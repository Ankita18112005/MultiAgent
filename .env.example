# Google Gemini API Key (Get free key: https://aistudio.google.com)
GOOGLE_API_KEY=your_gemini_api_key_here

# Tavily Search API Key (Get free key: https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Default Gemini Model (defaults to gemini-3.1-flash-lite)
# Automatically falls back across other models if rate-limited
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional Server Settings
PORT=5000
HOST=0.0.0.0
FLASK_DEBUG=0
